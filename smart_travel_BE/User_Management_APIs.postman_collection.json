{
	"info": {
		"_postman_id": "user-management-apis-001",
		"name": "User Management APIs - Smart Travel",
		"description": "Collection để test các API quản lý tài khoản người dùng cho Admin.\n\n## Endpoints:\n1. GET /api/v1/admin/users - Lấy danh sách users\n2. GET /api/v1/admin/users/{id} - Xem chi tiết user\n3. PUT /api/v1/admin/users/{id} - Cập nhật thông tin user\n4. POST /api/v1/admin/users/{id}/lock - Khóa tài khoản\n5. POST /api/v1/admin/users/{id}/unlock - Mở khóa tài khoản\n\n## Setup:\n- Đặt biến `baseUrl` trong environment (mặc định: http://localhost:8080)\n- Đặt biến `adminToken` với JWT token của admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get All Users (Pagination & Search)",
			"item": [
				{
					"name": "Get All Users - Page 1 (Default)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has correct structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('msg');",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('content');",
									"    pm.expect(jsonData.data).to.have.property('currentPage');",
									"    pm.expect(jsonData.data).to.have.property('totalPages');",
									"    pm.expect(jsonData.data).to.have.property('totalElements');",
									"});",
									"",
									"pm.test(\"Content is array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.content).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "{{adminUserId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/users?page=0&size=10&sortBy=createdAt&sortDirection=DESC",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "0",
									"description": "Số thứ tự trang (bắt đầu từ 0)"
								},
								{
									"key": "size",
									"value": "10",
									"description": "Số lượng items mỗi trang"
								},
								{
									"key": "sortBy",
									"value": "createdAt",
									"description": "Field để sắp xếp"
								},
								{
									"key": "sortDirection",
									"value": "DESC",
									"description": "ASC hoặc DESC"
								}
							]
						},
						"description": "Lấy danh sách users với pagination mặc định (trang 0, 10 items)"
					},
					"response": []
				},
				{
					"name": "Get All Users - Search by Name",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Search results contain keyword\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.content.length > 0) {",
									"        var firstUser = jsonData.data.content[0];",
									"        var keyword = pm.variables.get('searchKeyword').toLowerCase();",
									"        var matchFound = false;",
									"        ",
									"        if (firstUser.fullName && firstUser.fullName.toLowerCase().includes(keyword)) {",
									"            matchFound = true;",
									"        }",
									"        if (firstUser.email && firstUser.email.toLowerCase().includes(keyword)) {",
									"            matchFound = true;",
									"        }",
									"        if (firstUser.phone && firstUser.phone.includes(keyword)) {",
									"            matchFound = true;",
									"        }",
									"        ",
									"        pm.expect(matchFound).to.be.true;",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.variables.set('searchKeyword', 'admin');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "{{adminUserId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/users?page=0&size=10&searchKeyword=admin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "searchKeyword",
									"value": "admin",
									"description": "Tìm kiếm theo tên/email/SĐT"
								}
							]
						},
						"description": "Tìm kiếm users theo keyword (tên, email, hoặc số điện thoại)"
					},
					"response": []
				},
				{
					"name": "Get All Users - Search by Email",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
